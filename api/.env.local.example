# Copy to .env.local. It is gitignored. `just env` creates it and asks for
# the values below.
#
# Local development only. Nothing here is read in a deployment: the file is
# never committed, and settings.py falls back to the real environment when
# it is absent.
#
# The local admin. `just seed` creates this account in the worktree's
# database. A worktree copies the main checkout's file, so you enter
# these once.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# The client app, not this API. A sign-in email links to a page the
# client serves, so these two say where to find it.
#
# This service is the API and gets its own subdomain. It cannot work
# either of them out, and nothing here notices if they are wrong. The
# link simply goes nowhere.
#
# There is no client yet, so APP_URL has no default. Requesting a
# sign-in link fails until it is set, rather than mailing an address
# nothing serves.
APP_URL=
APP_MAGIC_LINK_PATH=

# Sending mail. Fastmail over SMTP, authenticated as an app password
# rather than the account password: SMTP refuses the account password
# once two-factor is on.
#
# Make one in Fastmail: Settings, Privacy & Security, Integrations, New
# App Password, scoped to SMTP.
#
# EMAIL_HOST_USER is the account that signs in. EMAIL_FROM is the
# address a reader sees. They may differ, and Fastmail refuses a From
# address the account does not own.
#
# Port 465 is implicit TLS. `settings.py` reads the port and sets
# EMAIL_USE_SSL or EMAIL_USE_TLS from it, so there is nothing else here.
EMAIL_HOST=smtp.fastmail.com
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=Statusboard <no-reply@statusboard.dev>

# Print the mail instead of sending it. Set this when a sign-in link
# should reach the terminal rather than a real inbox:
#
#   EMAIL_USE_CONSOLE=1 just dev
#
# It beats EMAIL_HOST, so the credentials above can stay in place.
# EMAIL_USE_CONSOLE=

# A deployment sets these. Development does not need them: SECRET_KEY
# falls back to a key in the repository, and DEBUG follows ENVIRONMENT.
# Outside development a missing SECRET_KEY stops the process.
# SECRET_KEY=
# DEBUG=
# ENVIRONMENT=

# Deploy credentials, for `just deploy`. A release goes through a tag and
# needs none of these: GitHub holds its own copy. This is for dispatching
# a redeploy from here.
#
# FORGEJO_HOST is the instance, with no trailing slash. FORGEJO_REPO is
# owner/repo. The token needs write:repository.
FORGEJO_HOST=
FORGEJO_REPO=
FORGEJO_TOKEN=
