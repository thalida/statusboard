# Copy to .env.local. It is gitignored. `just env` creates it and asks for
# the values below.
#
# Local development only. Nothing here is read in a deployment: the file is
# never committed, and settings.py falls back to the real environment when
# it is absent.
#
# The local admin. `just seed` creates this account in the worktree's
# database. A worktree copies the main checkout's .env.local, so you enter
# these once.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Where a sign-in link opens. Leave blank to use this worktree's own
# server, which is what `just dev` prints. Set it when the client runs
# somewhere else, such as a Vite server on another port.
SITE_URL=
