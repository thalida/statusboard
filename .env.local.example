# Copy to .env.local. It is gitignored. `just env` creates it and asks for
# the values below.
#
# Local development only. Nothing here is read in a deployment: the file is
# never committed, and settings.py falls back to the real environment when
# it is absent.
#
# The local admin. `just seed` creates this account in the worktree's
# database. A worktree copies the main checkout's .env.local, so you enter
# these once.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# The client app, not this API. A sign-in email links to a page the
# client serves, so these two say where to find it.
#
# This service is the API and gets its own subdomain, so it cannot work
# either of them out. Nothing here notices if they are wrong: the link
# just goes nowhere.
#
# Leave both blank while there is no client. SITE_URL then follows this
# worktree's own server, which is what `just dev` prints.
SITE_URL=
MAGIC_LINK_PATH=
