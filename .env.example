# Copy to .env. It is gitignored. `just init` creates it for you.
#
# The local admin. `just init` seeds this account into the worktree's
# database. A worktree reuses the main checkout's .env, so you enter these
# once. Local only: seed_admin refuses to run outside ENVIRONMENT=local.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
