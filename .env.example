# Copy to .env. It is gitignored. `just env` creates it and asks for the
# values below.
#
# The local admin. `just seed` creates this account in the worktree's
# database. A worktree copies the main checkout's .env, so you enter these
# once. Local only: seed_admin refuses to run outside ENVIRONMENT=local.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
